# TaxPilot Automation Environment Variables Example
# Copy this file to .env and configure your values securely.
# NEVER commit .env with real credentials.

# GitHub Personal Access Token (PAT) with repo permissions
GITHUB_TOKEN=your_github_token_here

# Target Repository Configuration
TARGET_REPO=https://github.com/Kishann911/TaxSarthi-.git
TARGET_BRANCH=main

# Git Commit Identity
GIT_USER_NAME=Kishan Ojha (TaxPilot Automation)
GIT_USER_EMAIL=kishanojha462@gmail.com

# Safety flag: Set to 'false' to actually push changes to GitHub, or 'true' for dry-run verification
DRY_RUN=true

