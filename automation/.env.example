# TaxSarthi Automation Environment Variables Example
# Copy this file to .env and configure your values securely.
# NEVER commit .env with real credentials.

# GitHub Personal Access Token (PAT) with repo permissions
GITHUB_TOKEN=your_github_token_here

# Target Repository Configuration
TARGET_REPO=https://github.com/karanb192/itr-wala.git
TARGET_BRANCH=main

# Git Commit Identity
GIT_USER_NAME=TaxSarthi Automation
GIT_USER_EMAIL=automation@taxsarthi.local

# Safety flag: Set to 'false' to actually push changes to GitHub, or 'true' for dry-run verification
DRY_RUN=true
